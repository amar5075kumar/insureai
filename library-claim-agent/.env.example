# ═══════════════════════════════════════════════════════════════════
# Library Claim Agent — Environment Variables
# Copy to .env and fill in values.
# NEVER commit .env to git — it is in .gitignore.
# ═══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────
POSTGRES_USER=claim_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_32_chars
POSTGRES_DB=library_claim

# ── Object Storage (MinIO) ──────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_strong_password_32_chars

# ── LiveKit WebRTC ──────────────────────────────────────────────────
# Generate API key: openssl rand -hex 12
LIVEKIT_API_KEY=devkey_CHANGE_ME
# Generate secret (must be ≥32 chars): openssl rand -hex 32
LIVEKIT_API_SECRET=CHANGE_ME_at_least_32_characters_long

# ── LLM Configuration ───────────────────────────────────────────────
# Option 1: Anthropic Claude (recommended for SLOW profile + any profile's review agent)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Option 2: Local Ollama (no key required — pull models after docker compose up)
# Automatically used when SWEEP_PROFILE=standard or hot
# docker exec library-claim-agent-ollama-1 ollama pull llama3.1:8b

# ── Sweep Profile ───────────────────────────────────────────────────
# Options: slow (laptop, cloud LLM) | standard (GPU, mixed) | hot (full GPU)
SWEEP_PROFILE=standard

# ── Optional: Per-component overrides ───────────────────────────────
# Override the conversation LLM without changing the full profile:
# CONV_LLM_OVERRIDE=claude-haiku-4-5-20251001
# CONV_PROVIDER_OVERRIDE=anthropic

# Override YOLOv8 device (e.g., force CPU on machine without GPU):
# YOLO_DEVICE_OVERRIDE=cpu

# Override pricing worker concurrency:
# PRICING_WORKERS_OVERRIDE=3

# ── Optional: Google Books API (higher rate limit) ───────────────────
# Free tier: 1000 queries/day, no key needed for basic use
# GOOGLE_BOOKS_API_KEY=REPLACE_ME

# ── Monitoring (optional) ────────────────────────────────────────────
# GRAFANA_PASSWORD=admin
